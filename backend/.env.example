PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PLATFORM_DELIVERY_FEE=30

# --- Database (Supabase Postgres, "Session pooler" connection string) ---
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Email for OTP codes ---
# On hosts that block SMTP ports (e.g. Render free tier) use Brevo's HTTPS API:
BREVO_API_KEY=
MAIL_FROM_EMAIL=
# Optional SMTP fallback. Leave SMTP_HOST empty in development to print codes in the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mandi Market <no-reply@yourdomain.com>"

# Used by `npm run seed`: a real inbox you control (admin login needs an emailed OTP)
ADMIN_EMAIL=