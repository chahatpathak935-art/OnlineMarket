PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PLATFORM_DELIVERY_FEE=30

# --- Email for OTP codes ---
# Leave SMTP_HOST empty in development: codes are printed in the server console.
# In production SMTP_HOST is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mandi Market <no-reply@yourdomain.com>"
